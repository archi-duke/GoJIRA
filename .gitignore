# Dependencies
GoJIRA-App/node_modules/
GoJIRA-App/build/

# Go binary
GoJIRA-API/gojira-api
GoJIRA-API/gojira-api.exe
GoJIRA-API/server
Platform-API/platform-api
Platform-API/platform-api.exe
gojira-launcher/gojira-launcher
gojira-launcher/gojira-launcher.exe

# Env
.env

# dev 런타임 주입 파일 — dev 에서 window._env_ 로 REACT_APP_* 주입용.
# deploy 는 컨테이너 entrypoint 가 자체 생성하므로 레포에 커밋하지 않는다.
Platform-App/public/env.js
GoJIRA-App/public/env.js

# TLS 인증서 (개인키 포함 — 절대 커밋 금지)
deploy/certs/*
!deploy/certs/.gitkeep
!deploy/certs/README.md

# Python
__pycache__/
*.pyc

# OS
.DS_Store

# Playwright
playwright-report/
test-results/

# Cache
GoJIRA-API/cache/

# Module Federation 자동 생성물 (DTS/런타임 임시)
@mf-types/
.__mf__temp/

# Docs backup
docs-bkg/

# IDE
.idea/
.vscode/

# Claude (로컬 설정은 무시하되 skills / 공유 hooks / 프로젝트 settings 는 추적)
.claude/*
!.claude/skills/
!.claude/settings.json
!.claude/hooks/
Platform-API/server
Platform-App/build/
node_modules/
repos/
screenshot*.png
# Ad-hoc 작업 캡처 (e1.png, e2.png 등 1글자 + 숫자 패턴)
[a-z][0-9]*.png
scripts/
!Agent-Service/scripts/
!deploy/scripts/
package.json
package-lock.json
# pumlex(vendored workspace)는 폐쇄망 오프라인 빌드(build-cache-node)가 읽어야 하므로
# 위 광범위 package.json 무시에서 제외 — fresh clone 에도 포함되어야 build 가능.
!deploy/vendor/pumlex/package.json
!deploy/vendor/pumlex/packages/*/package.json
# @platform/web-ui 소스 패키지 (packages/) — 위 광범위 무시에서 제외.
# lock 은 build-cache-node 의 npm ci 가 읽으므로 반드시 추적.
!packages/*/package.json
!packages/*/package-lock.json

# 미리 빌드된 런처 바이너리 (호스팅 dist) — 거대한 산출물, 커밋 X
deploy/launcher-dist/*/
deploy/launcher-dist/version.txt

# launcher embed: 에이전트 자산(.claude/.opencode/opencode.json)은 빌드시 복사되며 레포 루트가 단일 진실
gojira-launcher/assets/.claude/
gojira-launcher/assets/.opencode/
gojira-launcher/assets/opencode.json

# launcher 런타임/빌드 산출물
gojira-launcher/*.log
gojira-launcher/dist-out/
gojira-launcher/out-*

# 폐쇄망 배포 tar 산출물 (거대 — 커밋 X)
*.tar

# 패키징 산출물 (deploy/scripts/pack-web-ui.sh 의 tarball 등) — 커밋 X
deploy/dist/
