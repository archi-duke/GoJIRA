# Dependencies
GoJIRA-App/node_modules/
GoJIRA-App/build/

# Go binary
GoJIRA-API/gojira-api
GoJIRA-API/server
Platform-API/platform-api
gojira-launcher/gojira-launcher
gojira-launcher/gojira-launcher.exe

# Env
.env

# Python
__pycache__/
*.pyc

# OS
.DS_Store

# Playwright
playwright-report/
test-results/

# Cache
GoJIRA-API/cache/

# Docs backup
docs-bkg/

# IDE
.idea/
.vscode/

# Claude (설정은 무시하되 skills는 추적)
.claude/*
!.claude/skills/
Platform-API/server
Platform-App/build/
node_modules/
repos/
screenshot*.png
# Ad-hoc 작업 캡처 (e1.png, e2.png 등 1글자 + 숫자 패턴)
[a-z][0-9]*.png
scripts/
!Agent-Service/scripts/
!deploy/scripts/
package.json
package-lock.json
# pumlex(vendored workspace)는 폐쇄망 오프라인 빌드(build-cache-node)가 읽어야 하므로
# 위 광범위 package.json 무시에서 제외 — fresh clone 에도 포함되어야 build 가능.
!deploy/vendor/pumlex/package.json
!deploy/vendor/pumlex/packages/*/package.json

# 미리 빌드된 런처 바이너리 (호스팅 dist) — 거대한 산출물, 커밋 X
deploy/launcher-dist/*/
deploy/launcher-dist/version.txt

# launcher embed: 에이전트 자산(.claude/.opencode/opencode.json)은 빌드시 복사되며 레포 루트가 단일 진실
gojira-launcher/assets/.claude/
gojira-launcher/assets/.opencode/
gojira-launcher/assets/opencode.json

# launcher 런타임/빌드 산출물
gojira-launcher/*.log
gojira-launcher/dist-out/
gojira-launcher/out-*

# 폐쇄망 배포 tar 산출물 (거대 — 커밋 X)
*.tar
