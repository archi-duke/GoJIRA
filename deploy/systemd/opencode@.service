[Unit]
# 사용자별 OpenCode 인스턴스 systemd template — 인스턴스명 %i = userId.
# 한 번 배포 후:
#   systemctl enable --now opencode@<user>.service
#   systemctl status opencode@<user>.service
#   journalctl -u opencode@<user>.service -f
#
# 환경: /etc/gojira/opencode-<user>.env 가 EnvironmentFile 로 주입된다.
# 필수 변수:
#   OPENCODE_PORT             — 사용자별 고유 포트
#   OPENCODE_SERVER_PASSWORD  — OpenCode 서버 password (사용자별 생성)
#   OPENCODE_BIN              — opencode 바이너리 절대 경로 (예: /usr/local/bin/opencode)
#   WORKING_DIR               — opencode 가 시작할 작업 디렉토리 (보통 GoJIRA 레포 루트)
Description=OpenCode server for user %i
After=network.target

[Service]
Type=simple
# 사용자별 OS 계정 분리는 채택하지 않음 — Mongo userId 와 OS uid 매핑이 1:1 이어야 한다는 운영 제약이 큼.
# 대신 동일 service 계정으로 실행하고 fs 격리는 worktree(.worktrees/<userId>/) 가 담당.
User=gojira
Group=gojira
EnvironmentFile=/etc/gojira/opencode-%i.env
WorkingDirectory=/opt/gojira
ExecStart=/bin/sh -c '"$OPENCODE_BIN" serve --port "$OPENCODE_PORT" --hostname 0.0.0.0'
Restart=on-failure
RestartSec=5s
# 비정상 종료 반복 차단 (5분 내 5회 실패 시 더 이상 재시작 안 함)
StartLimitIntervalSec=300
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
