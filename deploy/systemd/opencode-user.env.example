# /etc/gojira/opencode-<user>.env  (모드 600 권장 — password 포함)
#
# 이 파일은 gojira-user-add.sh 가 자동 생성한다. 수동 편집 시:
#   sudo install -m 600 -o root -g root opencode-user.env.example /etc/gojira/opencode-batman.env
#   sudo vi /etc/gojira/opencode-batman.env
#   sudo systemctl restart opencode@batman.service

OPENCODE_PORT=4096
OPENCODE_SERVER_PASSWORD=CHANGE_ME
OPENCODE_BIN=/usr/local/bin/opencode
WORKING_DIR=/opt/gojira
