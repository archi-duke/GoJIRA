          "sha256": "7a5900ef695212a2bfb2fc59f7ecfb15393f67c1c906c03f4c7d7beb31614dbd"
        }
      },
      "policy": "optional",
      "requires": [
        "powershell",
        "office-com"
      ],
      "routes": [
        {
          "maxBodyMB": 200,
          "methods": [
            "POST"
          ],
          "prefix": "/v1/docs/pptx",
          "timeoutSec": 240
