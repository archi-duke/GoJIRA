# ─────────────────────────────────────────────────────────────────────────────
# GoJIRA 사내 폐쇄망 배포 — 단일 설정 출처
# ─────────────────────────────────────────────────────────────────────────────
# 이 파일이 docker-compose.yml 의 모든 환경변수 / build-args 의 입력. 사내 배포
# 시점에 `.env` 로 복사 후 placeholder 를 채워서 사용한다.
#
# `?required` 마크가 있는 변수는 docker-compose 가 비어있으면 fail-fast.
# ─────────────────────────────────────────────────────────────────────────────

# ── 이미지 태그 ──────────────────────────────────────────────────────────────
IMAGE_TAG=latest

# ── 호스트 노출 포트 (기본값과 다르게 쓸 경우만 변경) ────────────────────────
# PLATFORM_API_HOST_PORT=9000
# GOJIRA_API_HOST_PORT=9001
# AGENT_SERVICE_HOST_PORT=9002
# JIRA_API_HOST_PORT=8000
# PLATFORM_APP_HOST_PORT=3000
# GOJIRA_APP_HOST_PORT=3001
# PLANTUML_HOST_PORT=8080

# ── 사내 인프라 (별도 운영) ─────────────────────────────────────────────────
# 두 서비스 모두 같은 DB 사용. 인증/비밀번호 특수문자는 URL encoding (예: @ → %40).
PLATFORM_MONGO_URI=mongodb://dbadmin:P%40ssw0rd@10.227.37.89:27017/?authSource=admin
GOJIRA_MONGO_URI=mongodb://dbadmin:P%40ssw0rd@10.227.37.89:27017/?authSource=admin

# Gitea (사내) — endpoint 끝에 / 포함
GITHUB_URL=http://10.227.37.92:44350/
PLATFORM_GITHUB_TOKEN=<gitea-personal-access-token>
PLATFORM_GITHUB_ORG=

# ── OpenCode (사내 별도 호스트) ─────────────────────────────────────────────
# 사내에 운영 중인 OpenCode serve 의 base URL
OPENCODE_SERVER_URL=http://<opencode-host>:4096
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=

# ── Service-to-service URL (컴포즈 내부 — 보통 변경 불필요) ────────────────
# 컴포즈 내부에서는 서비스명으로 통신. 기본값 사용 권장.
# PLATFORM_GOJIRA_API=http://gojira-api:9001/api/v2
# GOJIRA_PLATFORM_API=http://platform-api:9000/api/v2
# GOJIRA_API_URL=http://gojira-api:9001/api/v2
# GOJIRA_JIRA_URL=http://jira-api:8000

# ── 시크릿 마스터 키 (ENC: 값 복호화에 사용) ───────────────────────────────
# 기존 환경에서 사용하던 키와 동일해야 ENC: 값들이 복호화됨. 미설정 시 코드 default.
# GOJIRA_ENC_KEY=

# ── JIRA 인증 (선택 — mock 사용 시 불필요) ─────────────────────────────────
# GOJIRA_JIRA_USER=ENC:<aes-256-gcm>
# GOJIRA_JIRA_PASS=ENC:<aes-256-gcm>

# ── SMTP (선택) ─────────────────────────────────────────────────────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=ENC:<aes-256-gcm>
# SMTP_FROM=

# ── LLM (사내 LLM gateway / OpenAI) ─────────────────────────────────────────
# config/llm.json 의 active provider 가 OpenAI 면 OPENAI_API_KEY, 사내(Internal)
# 면 PLATFORM_LLM_TICKET / PLATFORM_LLM_USER_ID 사용. 둘 다 ENC: 형식.
# OPENAI_API_KEY=ENC:<aes-256-gcm>
# PLATFORM_LLM_TICKET=ENC:<aes-256-gcm>
# PLATFORM_LLM_USER_ID=<ad-id>

# ─────────────────────────────────────────────────────────────────────────────
# 프론트엔드 빌드 시점에 inline 되는 변수들
# ─────────────────────────────────────────────────────────────────────────────
# CRA 가 빌드 산출물에 inline 하므로 호스트가 바뀌면 재빌드 필요.
# 브라우저가 호출할 endpoint 이므로 사내 사용자가 접근 가능한 URL 로.

REACT_APP_PLATFORM_API=http://<gojira-host>:9000/api/v2
REACT_APP_GOJIRA_API=http://<gojira-host>:9001/api/v2
REACT_APP_API_BASE=http://<gojira-host>:9001/api/v2
REACT_APP_AGENT_API=http://<gojira-host>:9002/api/v2
REACT_APP_GOJIRA_APP_REMOTE=http://<gojira-host>:3001
REACT_APP_PLANTUML_SERVER=http://<gojira-host>:8080/svg/
# REACT_APP_PUMLEX_SERVER=http://<pumlex-host>:3030
# REACT_APP_SSO_URL=https://10.227.37.90:443
