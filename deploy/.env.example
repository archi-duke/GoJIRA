# ─────────────────────────────────────────────────────────────────────────────
# GoJIRA 사내 폐쇄망 배포 — 단일 설정 출처 (atomic 입력)
# ─────────────────────────────────────────────────────────────────────────────
# 이 파일은 docker-compose.yml 의 모든 환경변수 / build-args / ports 매핑의 입력.
# 사내 배포 시점에 `.env` 로 복사 후 placeholder 를 채워서 사용한다.
#
# 원칙:
#   - 외부 인프라 (Mongo, Gitea) → host:port 한 줄 통합
#   - 나머지 서비스 (GoJIRA 6 서비스) → host + port 분리
#   - 조합된 URL (MONGO_URI, GOJIRA_API_URL, REACT_APP_* 등) 은 compose 가 생성
#   - .env 내부 변수 참조 (${SERVER1}) 지원 — 단일 host 공유 시 DRY
#   - `?required` 마크가 있는 변수는 비어있으면 compose 가 fail-fast
#
# 주의: *_SERVER 값에는 `http://` / `mongodb://` 같은 scheme prefix 를 넣지 않는다.
#       compose 가 조합 시 prefix 를 자동으로 붙임. 예) MONGODB_SERVER=host:27017
# ─────────────────────────────────────────────────────────────────────────────

# ── 이미지 태그 ──────────────────────────────────────────────────────────────
IMAGE_TAG=latest

# ─────────────────────────────────────────────────────────────────────────────
# 호스트 별칭 (DRY — 여러 변수가 같은 host 를 공유할 때 한 곳에서 관리)
# ─────────────────────────────────────────────────────────────────────────────
# 단일 호스트 / 분산 호스트 모두 지원:
#   - GoJIRA 서비스 모두 한 서버: SERVER1 에 그 host 한 번만 입력
#   - 완전 분산 배포: 아래 SERVER1 무시하고 각 *_SERVER 에 직접 host
SERVER1=<gojira-host>

# ─────────────────────────────────────────────────────────────────────────────
# 외부 인프라 (host:port 한 줄)
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB — 2개 백엔드 (Platform-API / GoJIRA-API) 공용
# scheme 없이 host:port 만. 예) MONGODB_SERVER=10.227.37.89:27017
MONGODB_SERVER=<mongo-host>:27017
MONGO_USER=<user>
MONGO_PASS=<pw>
MONGO_AUTH_SOURCE=admin

# Gitea — scheme 없이 host:port 만. 예) GITEA_SERVER=10.227.37.92:44350
GITEA_SERVER=<gitea-host>:3300
PLATFORM_GITHUB_TOKEN=<gitea-personal-access-token>
PLATFORM_GITHUB_ORG=<gitea-org>

# ─────────────────────────────────────────────────────────────────────────────
# 호스트 파일시스템 (Platform-API 컨테이너 ↔ 호스트 공유)
# ─────────────────────────────────────────────────────────────────────────────
# Platform-API 가 Gitea repo 를 bare clone / worktree 하는 작업 디렉토리.
# 호스트 측에 미리 `mkdir -p ${GOJIRA_REPOS_DIR}` 필요.
# 컨테이너 내부에서는 /data/repos 로 bind mount 됨 (Dockerfile 의 PLATFORM_REPO_DIR).
# 향후 OpenCode 스킬이 같은 디렉토리를 직접 fs read/write 할 때의 공유 약속점.
# 경로는 docker-compose.yml (deploy/) 기준 상대경로 또는 절대경로. 폐쇄망은 절대경로 권장.
# 예) GOJIRA_REPOS_DIR=/var/lib/gojira/repos
GOJIRA_REPOS_DIR=../repos

# 컨테이너가 호스트 사용자 권한으로 동작 — bind mount fs 권한 충돌 회피.
# 셸에서 `id -u` / `id -g` 값. Linux 일반 1000, macOS 보통 501.
UID=1000
GID=1000

# ─────────────────────────────────────────────────────────────────────────────
# 게이트웨이 (단일 진입점) + HTTPS 호스팅
# ─────────────────────────────────────────────────────────────────────────────
# 모든 브라우저 대면 트래픽(2 React 앱 + 2 API + pumlex)은 gateway 리버스 프록시
# 한 곳(GATEWAY_HOST:GATEWAY_PORT)으로 들어와 경로 기반으로 백엔드에 분배된다:
#   /                → Platform-App (shell SPA)
#   /gojira-app/     → GoJIRA-App (Module Federation remote)
#   /platform-api/…  → Platform-API
#   /gojira-api/…    → GoJIRA-API
#   /pumlex/…        → pumlex 렌더러
# 백엔드 컨테이너는 호스트에 직접 노출되지 않는다(compose 내부 네트워크만). 따라서
# 방화벽에는 GATEWAY_PORT 하나만 열면 된다.
#
# ── HTTPS 토글 ──────────────────────────────────────────────────────────────
# URL_SCHEME=https 면 gateway 가 인증서로 TLS 종단하고, React 에 주입되는 모든 URL
# 이 https(WebSocket 은 wss)로 조합된다. http(기본)면 평문. 스킴만 바꾸고
# `docker compose up -d` — React/백엔드 재빌드 불요(런타임 env.js + gateway 재설정).
URL_SCHEME=http

# 사용자/브라우저/스킬(런처)이 접속하는 단일 host & port.
# - GATEWAY_HOST: 인증서 CN/SAN 과 반드시 일치해야 한다(예: gojira.corp.local).
# - GATEWAY_PORT: gateway 가 listen + 외부 노출하는 포트. 기존 방화벽 등록 포트를
#   재사용해도 된다(예: 기존 Platform-App 포트). 이 값이 접속 URL 에 그대로 들어간다.
GATEWAY_HOST=${SERVER1}
GATEWAY_PORT=3000

# TLS 인증서 디렉토리(호스트 경로, docker-compose.yml 기준 상대/절대).
# URL_SCHEME=https 일 때 아래 두 파일이 반드시 존재해야 한다:
#   ${TLS_CERT_DIR}/fullchain.pem   (서버 인증서 + 중간 체인)
#   ${TLS_CERT_DIR}/privkey.pem     (개인키 — 절대 커밋 금지)
# 컨테이너에 /etc/gojira/tls 로 read-only mount 된다. http 모드면 비어 있어도 무방.
TLS_CERT_DIR=./certs

# ── 스킬/런처 연동 (자동) ────────────────────────────────────────────────────
# 런처(~/.gojira/launcher.json)는 스킬에 backend URL 을 주입하고 webOrigins 로 웹
# origin 을 검증한다. gateway 도입 후 이 값들은 launcher.json 의 단일 `gateway` 필드
# 에서 자동 파생된다 — 손편집 불요:
#   gateway = ${URL_SCHEME}://${GATEWAY_HOST}:${GATEWAY_PORT}
#     → backend.platformApi/gojiraApi (/platform-api·/gojira-api/api/v2) + webOrigins 자동
# 웹 설치 안내 모달이 `gojira-launcher install --gateway <이 주소>` 명령을 자동 제시하므로
# 사용자는 그대로 실행하면 gateway 가 launcher.json 에 자동 기록된다.
# (git.user/git.token 과, 자체서명 인증서 신뢰만 사용자 몫으로 남는다)

# ─────────────────────────────────────────────────────────────────────────────
# 시크릿 마스터 키 (선택)
# ─────────────────────────────────────────────────────────────────────────────
# 기존 환경에서 사용하던 키와 동일해야 ENC: 값들이 복호화됨. 미설정 시 코드 default.
# GOJIRA_ENC_KEY=

# ── JIRA 인증 (선택 — mock 사용 시 불필요) ─────────────────────────────────
# GOJIRA_JIRA_USER=ENC:<aes-256-gcm>
# GOJIRA_JIRA_PASS=ENC:<aes-256-gcm>

# ── 알림 발송 (선택) ─────────────────────────────────────────────────────────
# provider: smtp(사외/dev) | internal(사내 알림 API) | none(비활성)
# 미설정 시 자동: SMTP_HOST 있으면 smtp, 없으면 none
# NOTIFY_PROVIDER=
# 사내 알림 API (NOTIFY_PROVIDER=internal — 스펙 확정 전 스텁, 로그만 출력)
# NOTIFY_API_URL=
# NOTIFY_API_TOKEN=ENC:<aes-256-gcm>

# ── SMTP (NOTIFY_PROVIDER=smtp 또는 자동 판별 시) ────────────────────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=ENC:<aes-256-gcm>
# SMTP_FROM=

# ── LLM (사내 LLM gateway / OpenAI) ─────────────────────────────────────────
# config/llm.json 의 active provider 가 OpenAI 면 OPENAI_API_KEY, 사내(Internal)
# 면 PLATFORM_LLM_TICKET / PLATFORM_LLM_USER_ID 사용. 둘 다 ENC: 형식.
# OPENAI_API_KEY=ENC:<aes-256-gcm>
# PLATFORM_LLM_TICKET=ENC:<aes-256-gcm>
# PLATFORM_LLM_USER_ID=<ad-id>

# ── SSO (선택) ─────────────────────────────────────────────────────────────
# REACT_APP_USE_SSO=true 면 ADSSO 쿠키 확인 + 미인증 시 SSO 리다이렉트(운영).
# false/미설정이면 고정 DEV_USER 로 동작(개발). 두 앱(GoJIRA-App·Platform-App) 공통.
# REACT_APP_USE_SSO=false
# REACT_APP_SSO_URL=https://<sso-host>
