# Platform-API 환경 설정
#
# 필수 항목은 미설정 시 startup 에서 log.Fatal — silent localhost fallback 차단.
# 임의의 default 값이 들어가지 않도록 명시적으로 환경별 호스트를 입력해야 한다.

# ── 필수 ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://<host>:27017
PLATFORM_GITHUB_TOKEN=<gitea-or-github-pat>
PLATFORM_GITHUB_ORG=<org-name>
GITHUB_URL=http://<gitea-host>:3300/
GOJIRA_API_URL=http://<gojira-api-host>:9001/api/v2

# ── 선택 (default 적용) ────────────────────────────────────────────────
# PLATFORM_SERVER_PORT=:9000
# PLATFORM_MONGO_DB=gojira
# PLATFORM_REPO_DIR=./repos
# PLATFORM_WEBHOOK_URL=
# PLATFORM_WEBHOOK_SECRET=gojira-webhook-secret
# PLATFORM_EDIT_SESSION_TTL=30

# ── 알림 발송 (PR 승인요청/머지가능 등) ─────────────────────────────────
# provider: smtp(사외/dev) | internal(사내 알림 API) | none(비활성)
# 미설정 시 자동: SMTP_HOST 있으면 smtp, 없으면 none
# NOTIFY_PROVIDER=
# 사내 알림 API (NOTIFY_PROVIDER=internal — 스펙 확정 전 스텁, 로그만 출력)
# NOTIFY_API_URL=
# NOTIFY_API_TOKEN=ENC:<aes-256-gcm>

# ── SMTP (NOTIFY_PROVIDER=smtp 또는 자동 판별 시) ──────────────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=ENC:<aes-256-gcm>
# SMTP_FROM=

# ── LLM (시크릿) ──────────────────────────────────────────────────────
# 평문 키를 cmd/encrypt 로 ENC: 변환 후 입력. 마스터 키는 GOJIRA_ENC_KEY 환경변수.
# OPENAI_API_KEY=ENC:<aes-256-gcm>
# PLATFORM_LLM_TICKET=ENC:<aes-256-gcm>
# PLATFORM_LLM_USER_ID=<ad-id>

# ── 시크릿 마스터 키 (선택, 미설정 시 코드 default 사용) ─────────────
# GOJIRA_ENC_KEY=<32-byte-key>
