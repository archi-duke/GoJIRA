# 단위 테스트용 더미 설정 — 실제 비밀값이 아니다.
#
# config.init() 이 requireEnv 로 아래 값들을 요구해(미설정 시 log.Fatal) config 를
# import 하는 패키지의 테스트가 기동조차 못 한다. 이 파일은 그 최소 요건만 채운다.
# 테스트는 httptest 로 Gitea API 를 스텁하고 Mongo 에는 접근하지 않으므로
# 값 자체는 쓰이지 않는다.
#
# 사용: PLATFORM_ENV_FILE=testdata/test.env go test ./github/
# (경로는 패키지 디렉터리 기준. config.init() 이 TestMain 보다 먼저 돌기 때문에
#  코드로 자동 지정할 수 없어 호출 측에서 지정해야 한다.)
MONGO_URI=mongodb://localhost:27017/test
PLATFORM_GITHUB_TOKEN=dummy-admin-token
PLATFORM_GITHUB_ORG=gojira
GITHUB_URL=http://localhost:3300
GOJIRA_API_URL=http://localhost:9001/api/v2
