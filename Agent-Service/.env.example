# GoJIRA Agent Service (OpenCode 브리지 모드) 환경 설정
#
# 필수 항목은 미설정 시 startup 에서 ValidationError 발생 (fail-fast).
# default 가 없는 이유: 환경(개발/사내) 마다 호스트가 다른데 임의의 localhost
# fallback 이 silent 하게 동작하면 디버깅이 어려워지기 때문.

# ── 필수 ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://<host>:27017
GOJIRA_API_URL=http://<gojira-api-host>:9001/api/v2
GOJIRA_PLATFORM_API=http://<platform-api-host>:9000/api/v2
# OpenCode 위치는 환경별로 다름:
#   - 단일 호스트(Mac 단독 / Linux 단독): http://localhost:4096
#   - 게스트 VM + 호스트의 OpenCode: http://<host-ip>:4096  (예: Parallels 공유망 Mac = 10.211.55.2)
#   - 사내 폐쇄망 컨테이너 / 별도 서버: http://<opencode-host>:4096
# OpenCode 자체는 cwd 의 opencode.json 을 읽으므로 repo 디렉토리에서 `opencode serve --hostname 0.0.0.0 --port 4096` 으로 띄워야 외부 노출됨
OPENCODE_SERVER_URL=http://<opencode-host>:4096

# ── 선택 (default 적용) ────────────────────────────────────────────────
# AGENT_SERVICE_PORT=9002
# GOJIRA_MONGO_DB=gojira
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=
