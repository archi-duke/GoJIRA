# GoJIRA Agent Service 환경 설정
# Go GoJIRA-API와 동일한 환경변수명 사용

GOJIRA_MONGO_URI=mongodb://localhost:27017
GOJIRA_MONGO_DB=gojira
GOJIRA_API_URL=http://localhost:9001/api/v2
GOJIRA_PLATFORM_API=http://localhost:9000/api/v2
OPENAI_API_KEY=sk-xxx
AGENT_SERVICE_PORT=9002

# 선택: llm.json 경로 (비어있으면 자동 탐색)
# GOJIRA_LLM_CONFIG=./llm.json

# 선택: SKILL.md 디렉토리 (비어있으면 자동 탐색)
# GOJIRA_SKILLS_DIR=../GoJIRA-API/skills
