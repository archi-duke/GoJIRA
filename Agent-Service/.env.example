# GoJIRA Agent Service (OpenCode 브리지 모드) 환경 설정

GOJIRA_MONGO_URI=mongodb://localhost:27017
GOJIRA_MONGO_DB=gojira
GOJIRA_API_URL=http://localhost:9001/api/v2
GOJIRA_PLATFORM_API=http://localhost:9000/api/v2
AGENT_SERVICE_PORT=9002

# OpenCode 서버 (사용자 PC 로컬). LLM 호출은 OpenCode 가 자체 정책으로 수행하므로
# 본 서비스는 OpenAI / 기타 LLM 키를 보유하지 않는다.
OPENCODE_SERVER_URL=http://localhost:4096
# OPENCODE_SERVER_USERNAME=opencode
# OPENCODE_SERVER_PASSWORD=
