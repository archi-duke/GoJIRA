{
  "_comment_": "active 필드로 프로바이더 선택. 환경변수 GOJIRA_LLM_ACTIVE 로 override 가능. gemini/gemini-pro 는 LiteLLM 프록시(localhost:4000) 경유로 네이티브 함수호출을 OpenAI 호환 포맷으로 변환. LiteLLM 실행 방법은 litellm_config.yaml 참조.",
  "active": "openai",
  "providers": {
    "openai": {
      "endpoint": "https://api.openai.com/v1/chat/completions",
      "model": "gpt-4o",
      "maxTokens": 8000,
      "temperature": 0.3,
      "headers": {
        "Content-Type": "application/json"
      },
      "authType": "bearer",
      "apiKeyEnv": "OPENAI_API_KEY"
    },
    "gemini": {
      "endpoint": "http://localhost:4000/v1/chat/completions",
      "model": "gemini-2.5-flash",
      "maxTokens": 8000,
      "temperature": 0.3,
      "headers": {
        "Content-Type": "application/json"
      },
      "authType": "bearer",
      "apiKeyEnv": "LITELLM_MASTER_KEY"
    },
    "gemini-pro": {
      "endpoint": "http://localhost:4000/v1/chat/completions",
      "model": "gemini-2.5-pro",
      "maxTokens": 8000,
      "temperature": 0.3,
      "headers": {
        "Content-Type": "application/json"
      },
      "authType": "bearer",
      "apiKeyEnv": "LITELLM_MASTER_KEY"
    }
  }
}