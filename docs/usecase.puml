@startuml Distributed_Autonomous_Intelligence_Platform_UseCase

title 분산 자율 지능형 플랫폼 (Distributed Autonomous Intelligence Platform)\nUse Case Diagram

left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
    BackgroundColor<<functional>> #DDEEFF
    BackgroundColor<<nonfunctional>> #E8F5E9
    BackgroundColor<<constraint>> #FFF3E0
    BorderColor #333333
}

' ===== Actors =====
actor "상위 시스템\n(MES/AMHS)" as UpperSystem
actor "운영자\n(Operator)" as Operator
actor "Cloud AI" as CloudAI
actor "Edge/On-Device AI" as EdgeAI
actor "설비\n(Equipment)" as Equipment
actor "로봇\n(AMR/AMMR)" as Robot

' ===== Platform Boundary =====
rectangle "분산 자율 지능형 플랫폼" {

    ' --- Functional Requirements ---
    package "기능 요구사항 (Functional)" {
        usecase "PFR-01\n에이전트 생애주기 관리\n(생성/배포/모니터링/회수)" as UC_Lifecycle <<functional>>
        usecase "PFR-02\n통합 통신 프레임워크\n(P2P/수직적 메시징)" as UC_Comm <<functional>>
        usecase "PFR-03\n이기종 시스템 연계\n(Northbound/Southbound)" as UC_Integration <<functional>>
        usecase "PFR-04\n지능형 오케스트레이션\n(작업 분배/라우팅)" as UC_Orchestration <<functional>>
        usecase "PFR-05\nAI 모델 관리 및 배포\n(MLOps/OTA)" as UC_ModelMgmt <<functional>>
    }

    ' --- Business Use Cases ---
    package "비즈니스 요구사항 (Business)" {
        usecase "작업 분석 및\n관제 수행" as UC_Monitor <<functional>>
        usecase "자율 판단 및\n작업 수행" as UC_Autonomous <<functional>>
        usecase "기기 간 P2P\n협업 수행" as UC_P2P <<functional>>
        usecase "자율 안전 모드\n전환" as UC_SafeMode <<functional>>
    }

    ' --- Non-Functional Requirements ---
    package "비기능 요구사항 (Non-Functional)" {
        usecase "PNFR-01\n대규모 수평적 확장\n(Scale-out)" as UC_Scale <<nonfunctional>>
        usecase "PNFR-02\n무중단 엣지 운영\n(Graceful Degradation)" as UC_Resilience <<nonfunctional>>
        usecase "PNFR-03\n초저지연 통신\n(ms 이하)" as UC_LowLatency <<nonfunctional>>
        usecase "PNFR-04\n제로 트러스트 보안\n(Mutual TLS)" as UC_Security <<nonfunctional>>
    }

    ' --- Constraints ---
    package "제약사항 (Constraints)" {
        usecase "PCON-01\n제한된 컴퓨팅 환경\n경량화 동작" as UC_Lightweight <<constraint>>
        usecase "PCON-02\n레거시 시스템\n점진적 공존" as UC_Legacy <<constraint>>
        usecase "PCON-03\n산업 안전 표준\n규격 준수" as UC_Safety <<constraint>>
    }
}

' ===== Actor Relationships =====
UpperSystem --> UC_Integration : 작업 지시
UpperSystem --> UC_Orchestration : Task 전달
Operator --> UC_Lifecycle : 관리
Operator --> UC_Monitor : 모니터링
CloudAI --> UC_Monitor
CloudAI --> UC_Orchestration
CloudAI --> UC_ModelMgmt
EdgeAI --> UC_Autonomous
EdgeAI --> UC_P2P
EdgeAI --> UC_SafeMode
Equipment --> UC_Integration : SECS/GEM\nOPC-UA
Robot --> UC_Integration : ROS\nMQTT
Robot --> UC_P2P
Equipment --> UC_Autonomous

' ===== Include / Extend Relationships =====
UC_Orchestration ..> UC_Comm : <<include>>
UC_P2P ..> UC_Comm : <<include>>
UC_Monitor ..> UC_Comm : <<include>>
UC_Autonomous ..> UC_Comm : <<include>>

UC_SafeMode ..> UC_Resilience : <<include>>
UC_Comm ..> UC_LowLatency : <<include>>
UC_Comm ..> UC_Security : <<include>>
UC_Orchestration ..> UC_Scale : <<include>>

UC_Lifecycle ..> UC_ModelMgmt : <<extend>>
UC_Integration ..> UC_Legacy : <<include>>
UC_Autonomous ..> UC_Lightweight : <<include>>
UC_Integration ..> UC_Safety : <<include>>

@enduml
