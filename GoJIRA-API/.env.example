# GoJIRA-API 환경 설정
#
# 필수 항목은 미설정 시 startup 에서 log.Fatal — silent localhost fallback 차단.

# ── 필수 ─────────────────────────────────────────────────────────────────
GOJIRA_MONGO_URI=mongodb://<host>:27017
GOJIRA_PLATFORM_API=http://<platform-api-host>:9000/api/v2
GOJIRA_JIRA_URL=http://<jira-host>:8000

# ── 선택 (default 적용) ────────────────────────────────────────────────
# GOJIRA_SERVER_PORT=:9001
# GOJIRA_MONGO_DB=gojira
# GOJIRA_JIRA_API_BASE=/rest/api/2

# ── 시크릿 (ENC: AES-256-GCM 으로 암호화 후 입력) ─────────────────────
# GOJIRA_JIRA_USER=ENC:<...>
# GOJIRA_JIRA_PASS=ENC:<...>

# ── 시크릿 마스터 키 (선택) ───────────────────────────────────────────
# GOJIRA_ENC_KEY=<32-byte-key>
